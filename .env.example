# Configuración de entorno — Módulo 2: Agente Conversacional Tecnoquímicas S.A.
# Copia este archivo a .env y completa las credenciales según tu proveedor.
# NUNCA hagas commit de .env al repositorio.

# Modelo LLM principal (Ollama local soberano o proveedor vía init_chat_model)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama

# Claves opcionales para modelos cloud vía init_chat_model (OpenAI / Gemini / Anthropic)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Base vectorial Qdrant (persistencia local o servidor remoto)
QDRANT_PATH=data/qdrant_db
QDRANT_COLLECTION=tq_knowledge_m2

# Memoria conversacional (Corto plazo SqliteSaver + Largo plazo Store)
SQLITE_CHECKPOINT_PATH=data/memory/checkpoints.sqlite
SQLITE_STORE_PATH=data/memory/long_term_store.json

# Observabilidad y Trazas LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=tecnoquimicas-modulo2-agent
